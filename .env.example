# Copy this file to .env.local for local development and fill in real values.
# .env.local is git-ignored, so your keys never get committed.
# In production, add the same variables in Vercel: Project > Settings > Environment Variables.
#
# None of these use the VITE_ prefix on purpose: Vite only exposes VITE_ variables
# to the browser, so these stay on the server.

# Resend API key (https://resend.com/api-keys). Use a "Sending access" key, not "Full access".
# If this is empty during `npm run dev`, form submissions are printed to the terminal instead of emailed.
RESEND_API_KEY=

# Where enquiries are delivered. Comma-separate for more than one address.
CONTACT_TO_EMAIL=you@example.com

# Sender shown on the notification email. Must be on a domain you have verified in Resend.
CONTACT_FROM_EMAIL="North & Noble Care website <forms@example.com>"

# Optional. Comma-separated list of site origins allowed to post the form,
# e.g. https://www.northandnoblecare.ca,https://northandnoblecare.ca
# If empty, only same-origin requests are accepted.
ALLOWED_ORIGINS=
